[
  {
    "id": "scenario_cafe",
    "title": "У кафе",
    "level": "A1.1",
    "goal_uk": "Замовити напій і ввічливо попросити рахунок.",
    "setting": "cafe",
    "npc_name": "Noor",
    "turns": [
      {
        "npc_nl": "Goedemiddag! Wat wilt u drinken?",
        "npc_uk": "Добрий день! Що бажаєте випити?",
        "expected_intents": [
          "order_drink"
        ],
        "accepted_examples": [
          "Ik wil graag een koffie.",
          "Een thee, alstublieft.",
          "Mag ik water?"
        ],
        "hint_uk": "Почни з: Ik wil graag… (Я хотів би / хотіла б…)"
      },
      {
        "npc_nl": "Prima. Wilt u er iets bij eten?",
        "npc_uk": "Добре. Бажаєте щось поїсти до напою?",
        "expected_intents": [
          "answer_yes_no",
          "order_food"
        ],
        "accepted_examples": [
          "Nee, dank u.",
          "Ja, graag. Een broodje."
        ],
        "hint_uk": "Можна відповісти: Nee, dank u. або Ja, graag."
      },
      {
        "npc_nl": "Dat is drie euro vijftig. Wilt u de rekening?",
        "npc_uk": "Це три євро п'ятдесят. Бажаєте рахунок?",
        "expected_intents": [
          "ask_bill",
          "thank"
        ],
        "accepted_examples": [
          "Ja, alstublieft.",
          "Dank u wel."
        ],
        "hint_uk": "Для ввічливості скажи: Ja, alstublieft."
      }
    ]
  },
  {
    "id": "scenario_shop",
    "title": "У магазині",
    "level": "A1.1",
    "goal_uk": "Запитати ціну та знайти потрібний товар.",
    "setting": "shop",
    "npc_name": "Noor",
    "turns": [
      {
        "npc_nl": "Hallo! Kan ik u helpen?",
        "npc_uk": "Вітаю! Можу Вам допомогти?",
        "expected_intents": [
          "ask_for_item",
          "answer_yes_no"
        ],
        "accepted_examples": [
          "Ja, ik zoek brood.",
          "Ik zoek water.",
          "Nee, dank u."
        ],
        "hint_uk": "Ik zoek… означає «Я шукаю…»"
      },
      {
        "npc_nl": "Dat ligt daar. Wilt u nog iets?",
        "npc_uk": "Це лежить там. Бажаєте ще щось?",
        "expected_intents": [
          "answer_yes_no",
          "ask_location"
        ],
        "accepted_examples": [
          "Nee, dank u.",
          "Waar is het brood?"
        ],
        "hint_uk": "Запитай: Waar is…? — Де…?"
      },
      {
        "npc_nl": "Dat kost twee euro. Wilt u betalen met kaart of cash?",
        "npc_uk": "Це коштує два євро. Бажаєте оплатити карткою чи готівкою?",
        "expected_intents": [
          "pay_card",
          "pay_cash"
        ],
        "accepted_examples": [
          "Met kaart, alstublieft.",
          "Cash, alstublieft."
        ],
        "hint_uk": "Met kaart — карткою; cash/contant — готівкою."
      }
    ]
  },
  {
    "id": "scenario_municipality",
