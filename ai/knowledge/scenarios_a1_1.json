          "confirm_appointment",
          "deny_appointment"
        ],
        "accepted_examples": [
          "Ja, ik heb een afspraak.",
          "Nee, ik heb geen afspraak."
        ],
        "hint_uk": "Ik heb een afspraak — У мене є запис."
      },
      {
        "npc_nl": "Wat is uw naam, alstublieft?",
        "npc_uk": "Як Вас звати?",
        "expected_intents": [
          "give_name"
        ],
        "accepted_examples": [
          "Mijn naam is Olena.",
          "Ik heet Danylo."
        ],
        "hint_uk": "Mijn naam is… або Ik heet…"
      },
      {
        "npc_nl": "Waarvoor komt u vandaag?",
        "npc_uk": "З яким питанням Ви сьогодні прийшли?",
        "expected_intents": [
          "ask_registration",
          "ask_document",
          "ask_help"
        ],
        "accepted_examples": [
          "Ik kom voor mijn inschrijving.",
          "Ik heb een vraag over mijn document.",
          "Kunt u mij helpen?"
        ],
        "hint_uk": "Якщо складно, скажи: Ik heb een vraag."
      }
    ]
  },
  {
    "id": "scenario_pharmacy",
    "title": "В аптеці",
    "level": "A1.1",
