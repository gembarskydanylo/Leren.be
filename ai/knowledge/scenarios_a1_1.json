    "npc_name": "Noor",
    "turns": [
      {
        "npc_nl": "Goedemiddag. Waarmee kan ik u helpen?",
        "npc_uk": "Добрий день. Чим можу Вам допомогти?",
        "expected_intents": [
          "describe_symptom",
          "ask_product"
        ],
        "accepted_examples": [
          "Ik heb hoofdpijn.",
          "Ik zoek een product."
        ],
        "hint_uk": "Ik heb hoofdpijn — У мене болить голова."
      },
      {
        "npc_nl": "Sinds wanneer heeft u klachten?",
        "npc_uk": "Відколи у Вас ці симптоми?",
        "expected_intents": [
          "duration_today",
          "duration_days"
        ],
        "accepted_examples": [
          "Sinds vandaag.",
          "Sinds twee dagen."
        ],
        "hint_uk": "Sinds vandaag — від сьогодні; sinds twee dagen — два дні."
      },
      {
        "npc_nl": "Gebruikt u andere medicijnen?",
        "npc_uk": "Ви приймаєте інші ліки?",
        "expected_intents": [
