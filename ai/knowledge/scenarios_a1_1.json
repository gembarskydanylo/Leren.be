        ],
        "accepted_examples": [
          "Ja, ik gebruik medicijnen.",
          "Nee, ik gebruik geen medicijnen."
        ],
        "hint_uk": "Медичні рішення залишай фармацевту або лікарю; AI допомагає з мовою."
      }
    ]
  },
  {
